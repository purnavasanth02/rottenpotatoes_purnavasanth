<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table id="movies">
  <thead>
    <tr>
      <% if @sort_column == "title" && @direction == "asc" %>
        <th class="asc">
          <%= link_to "Title ▲", movies_path(sort: "title", direction: "desc") %>
        </th>
      <% elsif @sort_column == "title" && @direction == "desc" %>
        <th class="desc">
          <%= link_to "Title ▼", movies_path(sort: "title", direction: "asc") %>
        </th>
      <% else %>
        <th>
          <%= link_to "Title", movies_path(sort: "title", direction: "asc") %>
        </th>
      <% end %>

      <% if @sort_column == "rating" && @direction == "asc" %>
        <th class="asc">
          <%= link_to "Rating ▲", movies_path(sort: "rating", direction: "desc") %>
        </th>
      <% elsif @sort_column == "rating" && @direction == "desc" %>
        <th class="desc">
          <%= link_to "Rating ▼", movies_path(sort: "rating", direction: "asc") %>
        </th>
      <% else %>
        <th>
          <%= link_to "Rating", movies_path(sort: "rating", direction: "asc") %>
        </th>
      <% end %>

      <% if @sort_column == "release_date" && @direction == "asc" %>
        <th class="asc">
          <%= link_to "Release Date ▲", movies_path(sort: "release_date", direction: "desc") %>
        </th>
      <% elsif @sort_column == "release_date" && @direction == "desc" %>
        <th class="desc">
          <%= link_to "Release Date ▼", movies_path(sort: "release_date", direction: "asc") %>
        </th>
      <% else %>
        <th>
          <%= link_to "Release Date", movies_path(sort: "release_date", direction: "asc") %>
        </th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr id="<%= dom_id movie %>">
        <td><%= link_to movie.title, movie %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date&.strftime("%b %-d, %Y") %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="3"><%= link_to "New movie", new_movie_path %></td>
    </tr>
  </tfoot>
</table>
